# Copy this to set_env.ps1 and fill in your values
# Never commit set_env.ps1 or .env

GITLAB_TOKEN=your-gitlab-pat-here
GITLAB_URL=https://gitlab.veevadev.com
JIRA_URL=https://jira.veevadev.com
JIRA_PAT=your-jira-pat-here
OPENSEARCH_URL=https://autoinfra-es.vaultdev.com:9200

# Optional: comma-separated GitLab usernames to auto-add as reviewers on every backport MR.
# Can also be specified per-run with: --reviewers username1 username2
BACKPORT_REVIEWERS=

# Optional: comma-separated labels to add on every backport MR (alongside original MR labels
# and the fixed "backport" label). Can also be specified per-run with: --labels label1,label2
BACKPORT_LABELS=